# Application runtime
NODE_ENV=

# Supabase — application runtime
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-only privileged key
# Не использовать в клиентском коде
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — server-only billing integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# OpenAI — server-only key used by Supabase Studio and future AI runtime
# Не использовать в клиентском коде и переменных NEXT_PUBLIC_*
OPENAI_API_KEY=

# EP-023 local webhook verification (optional)
# По умолчанию: http://localhost:3000/api/billing/webhook
EP023_WEBHOOK_URL=

# Supabase Auth providers (optional; currently disabled in supabase/config.toml)
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# Supabase experimental S3 storage settings (optional; currently not configured)
S3_HOST=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
